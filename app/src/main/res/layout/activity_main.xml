<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- ===== LOGIN ===== -->
        <LinearLayout
            android:id="@+id/loginBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📁 MediaSync"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:alpha="0.7"
                android:text="Copia de seguridad familiar en el PC de casa" />

            <EditText
                android:id="@+id/etServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Servidor (ej. 192.168.1.242:8080)"
                android:inputType="textUri" />

            <EditText
                android:id="@+id/etUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Usuario"
                android:inputType="textNoSuggestions" />

            <EditText
                android:id="@+id/etPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Contraseña"
                android:inputType="textPassword" />

            <TextView
                android:id="@+id/tvLoginErr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#E5534B" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Entrar" />
        </LinearLayout>

        <!-- ===== PRINCIPAL ===== -->
        <LinearLayout
            android:id="@+id/mainBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvHello"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvServer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.6" />

            <!-- Permiso -->
            <LinearLayout
                android:id="@+id/permBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#33E5534B"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚠ La app necesita permiso para leer los archivos del teléfono." />

                <Button
                    android:id="@+id/btnPerm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Dar permiso" />
            </LinearLayout>

            <!-- Estado -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:ellipsize="middle"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tvLast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.7" />

            <Button
                android:id="@+id/btnSync"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="14dp"
                android:text="⟳  Sincronizar ahora"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cancelar"
                android:visibility="gone" />

            <!-- Qué sincronizar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Qué sincronizar"
                android:textSize="18sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbFotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖼  Fotos" />

            <CheckBox
                android:id="@+id/cbVideos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎬  Vídeos" />

            <CheckBox
                android:id="@+id/cbAudio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎵  Música y audios (notas de voz, grabaciones)" />

            <CheckBox
                android:id="@+id/cbDocs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📄  Documentos (PDF, Word, Excel…)" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swWifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Solo con WiFi" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sincronizar sola (con WiFi de casa y cargando)" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Carpetas a excluir (una por línea)"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etExcluded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="Ej: Android/media/com.whatsapp/WhatsApp/Media/WhatsApp Stickers"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="2"
                android:textSize="13sp" />

            <!-- Otros -->
            <Button
                android:id="@+id/btnWeb"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Ver mis archivos en el servidor" />

            <Button
                android:id="@+id/btnRescan"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Volver a revisar todo el teléfono" />

            <Button
                android:id="@+id/btnLogout"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cerrar sesión" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.4"
                android:gravity="center"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
